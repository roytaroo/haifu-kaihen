{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "mmgplus:wave",
   "materials": {
    "default": "entity_alphablend"
   },
   "textures": {
    "default": "textures/entity/mpl_wave"
   },
   "geometry": {
    "default": "geometry.mpl.wave"
   },
   "render_controllers": [
    "controller.render.default"
   ],
   "animations": {
    "a": "animation.mpl.wave"
   },
   "scripts": {
    "pre_animation": [
     "v.ph = math.mod(math.abs(q.position(0) * 0.37 + q.position(2) * 0.61), 5.0);",
     "v.t = math.mod(q.life_time + v.ph, 5.0) / 5.0;",
     "v.p = v.t < 0.45 ? math.sin(v.t / 0.45 * 90.0) : 1.0 - math.pow((v.t - 0.45) / 0.55, 0.8);"
    ],
    "animate": [
     "a"
    ]
   }
  }
 }
